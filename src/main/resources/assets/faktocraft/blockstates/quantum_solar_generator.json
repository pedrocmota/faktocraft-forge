{
 "multipart": [
  {
   "apply": {
    "model": "faktocraft:block/generator/quantum_solar_generator"
   }
  },
  {
   "when": {
    "panel_north": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_edge"
   }
  },
  {
   "when": {
    "panel_east": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_edge",
    "y": 90
   }
  },
  {
   "when": {
    "panel_south": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_edge",
    "y": 180
   }
  },
  {
   "when": {
    "panel_west": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_edge",
    "y": 270
   }
  },
  {
   "when": {
    "OR": [
     {
      "panel_north": "false"
     },
     {
      "panel_west": "false"
     }
    ]
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner"
   }
  },
  {
   "when": {
    "OR": [
     {
      "panel_north": "false"
     },
     {
      "panel_east": "false"
     }
    ]
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner",
    "y": 90
   }
  },
  {
   "when": {
    "OR": [
     {
      "panel_south": "false"
     },
     {
      "panel_east": "false"
     }
    ]
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner",
    "y": 180
   }
  },
  {
   "when": {
    "OR": [
     {
      "panel_south": "false"
     },
     {
      "panel_west": "false"
     }
    ]
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner",
    "y": 270
   }
  },
  {
   "when": {
    "corner_nw": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner_inner"
   }
  },
  {
   "when": {
    "corner_ne": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner_inner",
    "y": 90
   }
  },
  {
   "when": {
    "corner_se": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner_inner",
    "y": 180
   }
  },
  {
   "when": {
    "corner_sw": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_corner_inner",
    "y": 270
   }
  },
  {
   "when": {
    "panel_north": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_shadow"
   }
  },
  {
   "when": {
    "panel_east": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_shadow",
    "y": 90
   }
  },
  {
   "when": {
    "panel_south": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_shadow",
    "y": 180
   }
  },
  {
   "when": {
    "panel_west": "false"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_rim_shadow",
    "y": 270
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_connector"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_connector",
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_connector",
    "y": 180
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "faktocraft:block/base/solar_panel_connector",
    "y": 270
   }
  },
  {
   "when": {
    "down": "true"
   },
   "apply": {
    "model": "faktocraft:block/generator/quantum_solar_generator_adapter",
    "x": 90
   }
  }
 ]
}
