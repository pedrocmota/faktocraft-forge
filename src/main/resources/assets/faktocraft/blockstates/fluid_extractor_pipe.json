    "x": 90
   }
  },
  {
   "when": {
    "north": "false"
   },
   "apply": {
    "model": "faktocraft:block/pipe/fluid_extractor_pipe_center_cap"
   }
  },
  {
   "when": {
    "east": "false"
   },
   "apply": {
    "model": "faktocraft:block/pipe/fluid_extractor_pipe_center_cap",
    "y": 90
   }
  },
  {
